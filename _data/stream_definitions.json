{
    "$schema": "http://json-schema.org/draft-07/schema",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "data": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/streamObject"
            }
        }
    },
    "definitions": {
        "streamObject": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "description": "The name of the stream",
                    "type": "string"
                },
                "tags": {
                    "description": "The tags for the stream, comma separated",
                    "type": "string"
                },
                "images": {
                    "description": "Images for the stream",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/streamImage"
                    }
                },
                "extras": {
                    "description": "Extra stuff, usually text or links",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/streamExtras"
                    }
                },
                "isAlive": {
                    "description": "Is the stream alive?",
                    "type": "boolean"
                },
                "id": {
                    "description": "Optional stable id for permalinks/favourites. Defaults to a slug of the name.",
                    "type": "string"
                },
                "description": {
                    "description": "Optional longer description shown in the detail panel",
                    "type": "string"
                },
                "region": {
                    "description": "Optional prefecture or area, e.g. \"Tokyo\" or \"Various\"",
                    "type": "string"
                },
                "lat": {
                    "description": "Optional latitude for the map view",
                    "type": "number"
                },
                "lng": {
                    "description": "Optional longitude for the map view",
                    "type": "number"
                },
                "addedAt": {
                    "description": "Optional date the stream was added (YYYY-MM-DD), used for NEW! badges",
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "submittedBy": {
                    "description": "Optional name to credit the person who submitted the stream",
                    "type": "string"
                }
            }
        },
        "streamImage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "src": {
                    "description": "The source of the image",
                    "type": "string"
                },
                "title": {
                    "description": "The title for the image",
                    "type": "string"
                },
                "width": {
                    "description": "The width for the image",
                    "type": "number"
                },
                "height": {
                    "description": "The height for the image",
                    "type": "number"
                },
                "alt": {
                    "description": "Alternative to title (written by the original trainstream-editor)",
                    "type": "string"
                }
            }
        },
        "streamExtras": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "link": {
                    "description": "The URL to open when clicking on text",
                    "type": "string"
                },
                "linkTitle": {
                    "description": "The title for link, appears when hovering",
                    "type": "string"
                },
                "text": {
                    "description": "The text to display, will override URL",
                    "type": "string"
                },
                "kind": {
                    "description": "Optional link type: \"home\" for a home page / camera portal. Leave out for a normal stream link.",
                    "type": "string",
                    "enum": [
                        "home"
                    ]
                }
            }
        }
    }
}
